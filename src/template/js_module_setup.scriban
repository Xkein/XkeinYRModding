{{- include 'include/meta.scriban'
    init_extra_vars(this)
    is_yrpp = module_name == "YRpp"
    func need_codegen(htType)
        ret get_meta_tag(htType.meta, "BindJs") && !htType.is_template_class
    end
-}}

{{- for klass in module_classes }}
{{- if need_codegen(klass) }}
exports.{{klass.identifier}} = puerts.loadCPPType("{{klass.full_name}}")
{{- end; end }}

{{- for enum in module_enums }}
{{- if need_codegen(enum) || is_yrpp }}
exports.{{enum.name}} = (function () {
    let {{enum.name}} = {}
    {{- for enum_item in enum.constants }}
    {{enum.name}}[{{enum.name}}["{{enum_item.name}}"] = {{enum_item.value}}] = "{{enum_item.name}}";
    {{- end}}
    return {{enum.name}};
})();
{{- end; end }}