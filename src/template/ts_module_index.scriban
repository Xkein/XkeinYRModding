{{- include 'include/meta.scriban'
    init_extra_vars(this)
    include 'include/yrpp.scriban'
    is_yrpp = module_name == "YRpp"
    include 'include/js_ts.scriban'
    func should_skip_visibility_ex(htType, htElement)
        if is_yrpp
            case htElement.element.visibility
                when 2, 3 # protected or private
                    ret true
                else
                    ret false
            end
        else
            ret should_skip_visibility(htType, htElement)
        end
    end
    func get_comment(element, extra_info = "")
        $comment = element.comment ?? ""
        if !string.empty(extra_info)
            if !string.empty($comment)
                $comment += "\n"
            end
            $comment += extra_info
        end
        ret (string.split($comment, "\n") | array.each do; ret "// " + $0; end) | array.join "\n"
    end
    func gen_property(property)
        $result = get_comment(property.cpp_field, property.cpp_field) + "\n"
        $result += (property.is_static ? 'static s_' : 'm_') + $'{property.name} : {get_ts_type(property.cpp_field.type)};'
        ret $result
    end
    func gen_method(function, cppFunction)
        $js_function_name = get_js_function_name(function.name)
        if string.empty($js_function_name)
            ret "// skip " + function.name
        end
        $result = get_comment(function.cpp_function, function.cpp_function) + "\n"
        if function.is_static
            $result += "static "
        end
        if function.is_constructor
            $result += "constructor"
        else
            $result += $js_function_name
        end
        $result += "("
        if function.is_override
            $result += array.each(cppFunction.parameters, do; ret ($'{$0.name+"_"+(param_idx++)} : {get_ts_type($0.type)} | any'); end) | array.join ", "
        else
            $result += array.each(cppFunction.parameters, do; ret ($'{$0.name+"_"+(param_idx++)} : {get_ts_type($0.type)}'); end) | array.join ", "
        end
        $result += ")"
        if !function.is_constructor
            $result += " : " + get_ts_type(cppFunction.return_type)
        end
        $result += ";"
        ret $result
    end
-}}
/// <reference path = "../index.d.ts"/>
declare module "{{module_name}}" {
import { $Ref } from "puerts";
{{- if !is_yrpp }}
import { CDTimerClass, AbstractClass, AbstractTypeClass, CCINIClass, LandType, Action, AircraftClass, AircraftTypeClass, AnimClass, AnimTypeClass, BuildingClass, BuildingTypeClass, BulletClass, BulletTypeClass, DamageState, DirType, FireError, GadgetClass, GadgetFlag, HouseClass, HouseTypeClass, InfantryClass, InfantryTypeClass, IStream, KeyModifier, MissionClass, ObjectClass, RulesClass, SuperClass, SuperWeaponTypeClass, TActionClass, TechnoClass, TechnoTypeClass, TerrainClass, TerrainTypeClass, TriggerClass, UnitClass, UnitTypeClass, Vector3D, WarheadTypeClass, WeaponTypeClass, ThemeClass, ThemeControl, Vector2D, AbstractType, FootClass, PassengersClass } from "YRpp";
{{- if module_name != "Wwise"}}
import { AKRESULT } from "Wwise";
{{- end }}
{{- end }}

{{- for klass in module_classes }}
{{- if need_codegen(klass) }}
{{ get_comment(klass.cpp_class, klass.full_name) }}
{{ klass.is_interface ? "interface" : "class" }} {{klass.identifier}}
{{- if array.size(klass.base_classes) > 0 && klass.base_classes[0].klass && !klass.base_classes[0].klass.is_interface
$base_name = get_ts_type(klass.base_classes[0].cpp_base_type.type)}}
    {{- if $base_name != "any"}}
    extends {{$base_name}}
    {{- end }}
{{- end }}
{
{{- for function in klass.all_functions ; $cpp_function = function.cpp_function }}
        {{- if should_skip_visibility_ex(klass, function) || function.is_deleted || function.is_destructor
            continue
        end
        param_idx = 0
        }}
    {{gen_method(function, $cpp_function)}}
{{- end }}
{{- for property in klass.properties ; $cpp_field = property.cpp_field }}
    {{- if should_skip_visibility_ex(klass, property)
            continue
        end
        if string.empty(property.name)
            continue
        end }}
    {{gen_property(property)}}
{{- end }}
{{- for inner_property in klass.anonymous_inline_properties }}
    {{gen_property(inner_property)}}
{{- end }}
}
{{- end }}
{{- end }}

class {{this.module_name}} {
{{- for property in this.properties ; $cpp_field = property.cpp_field
    if !need_codegen(property)
        continue
    end}}
    {{ get_comment(property.cpp_field, property.cpp_field) }}
    {{ $'static s_{property.identifier} : {get_ts_type(property.cpp_field.type)};'}}
{{- end}}
{{- for function in this.functions ; $cpp_function = function.cpp_function
    if !need_codegen(function)
        continue
    end
    if function.is_overload || function.cpp_function.is_function_template
        continue
    end
    param_idx = 0
    $params = array.each($cpp_function.parameters, do; ret ($'{$0.name+"_"+(param_idx++)} : {get_ts_type($0.type)}'); end) | array.join ", "
    }}
    {{ get_comment(function.cpp_function, function.cpp_function) }}
    {{ $'static {function.identifier}({$params}) : {get_ts_type($cpp_function.return_type)};' }}
{{- end }}
}

{{- for enum in module_enums }}
{{- if need_codegen(enum) || is_yrpp }}
{{ get_comment(enum.cpp_enum, enum.full_name) }}
enum {{enum.name}} {
    {{- for enum_item in enum.constants }}
    {{ get_comment(enum_item.cpp_enum_item, enum_item.cpp_enum_item) }}
    {{enum_item.name}} = {{enum_item.value}},
    {{- end}}
}
{{- end; end }}
}
