{{- include 'include/meta.scriban'
    init_extra_vars(this)
    include 'include/yrpp.scriban'
    include 'include/js_ts.scriban'
    is_yrpp = module_name == "YRpp"
    func need_codegen(htType)
        ret get_meta_tag(htType.meta, "BindJs") && !htType.is_template_class
    end
    type_map = {}
    type_map["void"] = "void"
    type_map["char"] = "number"
    type_map["wchar"] = "number"
    type_map["wchar_t"] = "number"
    type_map["unsigned char"] = "number"
    type_map["short"] = "number"
    type_map["unsigned short"] = "number"
    type_map["int"] = "number"
    type_map["unsigned int"] = "number"
    type_map["long"] = "number"
    type_map["unsigned long"] = "number"
    type_map["long long"] = "number"
    type_map["unsigned long long"] = "number"
    type_map["float"] = "number"
    type_map["double"] = "number"
    type_map["long double"] = "number"
    type_map["bool"] = "boolean"
    type_map["char *"] = "string"
    type_map["char const *"] = "string"
    type_map["std::basic_string<char, std::char_traits<char>, std::allocator<char>>"] = "string"
    # yr structs
    type_map["Vector2D<int>"] = "Vector2D"
    type_map["Vector2D<short>"] = "Vector2D"
    type_map["Vector3D<int>"] = "Vector3D"
    type_map["Vector3D<double>"] = "Vector3D"
    type_map["Vector3D<float>"] = "Vector3D"

    generic_types = ["VectorClass<", "DynamicVectorClass<", "TypeList<"]

    any_types = []
    if is_yrpp 
        any_types = array.concat(any_types, ["IndexClass"])
        yr_types = get_yr_types()
    end
    
    for klass in module_classes
        if need_codegen(klass)
            type_map[klass.full_name] = klass.identifier
        end
    end
    for enum in module_enums
        if need_codegen(enum) || is_yrpp
            type_map[enum.name] = enum.name
        end
    end
    func get_ts_type(type)
        $type_name = type.full_name
        for any_type in any_types
            # force use "any" type
            if string.contains($type_name, any_type)
                ret "any"
            end
        end
        $mapped_type = type_map[$type_name]
        # has mapped name
        if $mapped_type
            ret $mapped_type
        end
        $unwrap = httype.unwrap_type(type)
        $unwrap_name = $unwrap.full_name
        # is string
        if $unwrap_name == "char" && is_array_type(type)
            ret "string"
        end
        $mapped_type = type_map[$unwrap_name]
        # has mapped name
        if $mapped_type
            ret $mapped_type
        end
        # special template class
        if string.starts_with($unwrap_name, "constant_ptr<") || string.starts_with($unwrap_name, "reference<")
            ret get_ts_type($unwrap.template_specialized_arguments[0].arg_as_type)
        end
        # template class
        for generic_type in generic_types
            if string.starts_with($unwrap_name, generic_type)
                if $unwrap.template_kind == 3 # CppTemplateKind.TemplateSpecializedClass
                    $mapped_template_name = string.slice($unwrap_name, 0, string.index_of($unwrap_name, "<"))
                    $mapped_template_name += "<"
                    for template_specialized_argument in $unwrap.template_specialized_arguments
                        if template_specialized_argument.arg_kind == 0 # CppTemplateArgumentKind.AsType
                            $mapped_template_name += get_ts_type(template_specialized_argument.arg_as_type)
                        else
                            $mapped_template_name += template_specialized_argument.arg_string
                        end
                    end
                    $mapped_template_name += ">"
                    ret $mapped_template_name
                else if $unwrap.template_kind == 1 || $unwrap.template_kind == 2 # TemplateKind == CppTemplateKind.TemplateClass || TemplateKind == CppTemplateKind.PartialTemplateClass
                    $mapped_template_name = string.slice($unwrap_name, 0, string.index_of($unwrap_name, "<"))
                    $mapped_template_name += "<"
                    for template_parameter in $unwrap.template_parameters
                        $mapped_template_name += get_ts_type(template_parameter)
                    end
                    $mapped_template_name += ">"
                    ret $mapped_template_name
                else
                    ret $unwrap_name + "-ttt-" + $unwrap.type_kind
                    if string.ends_with($unwrap_name, "*>")
                        ret string.replace($unwrap_name, "*>", ">")
                    else
                        ret $unwrap_name
                    end
                end
            end
        end
        if $unwrap_name | string.contains ">" # template
            ret "any"
        end
        if $unwrap_name | string.contains "::"
            ret "any"
        end
        if is_yrpp && !array.contains(yr_types, $unwrap_name)
            ret "any"
        end
        ret $unwrap_name
    end
    func should_skip_visibility_ex(htType, htElement)
        if is_yrpp
            case htElement.element.visibility
                when 2, 3 # protected or private
                    ret true
                else
                    ret false
            end
        else
            ret should_skip_visibility(htType, htElement)
        end
    end
    func gen_property(property)
        ret (property.is_static ? 'static s_' : 'm_') + $'{property.name} : {get_ts_type(property.cpp_field.type)};'
    end
    func gen_method(function, cppFunction)
        $js_function_name = get_js_function_name(function.name)
        if string.empty($js_function_name)
            ret "// skip " + function.name
        end
        $result = ""
        if function.is_static
            $result += "static "
        end
        if function.is_constructor
            $result += "constructor"
        else
            $result += $js_function_name
        end
        $result += "("
        if function.is_override
            $result += array.each(cppFunction.parameters, do; ret ($'{$0.name+"_"+(param_idx++)} : {get_ts_type($0.type)} | any'); end) | array.join ", "
        else
            $result += array.each(cppFunction.parameters, do; ret ($'{$0.name+"_"+(param_idx++)} : {get_ts_type($0.type)}'); end) | array.join ", "
        end
        $result += ")"
        if !function.is_constructor
            $result += " : " + get_ts_type(cppFunction.return_type)
        end
        $result += ";"
        ret $result
    end
-}}
/// <reference path = "../index.d.ts"/>
declare module "{{module_name}}" {
{{- if !is_yrpp }}
import { CDTimerClass, AbstractClass, CCINIClass, LandType, Action, AircraftClass, AircraftTypeClass, AnimClass, AnimTypeClass, BuildingClass, BuildingTypeClass, BulletClass, BulletTypeClass, DamageState, DirType, FireError, GadgetClass, GadgetFlag, HouseClass, HouseTypeClass, InfantryClass, InfantryTypeClass, IStream, KeyModifier, MissionClass, ObjectClass, RulesClass, SuperClass, SuperWeaponTypeClass, TActionClass, TechnoClass, TechnoTypeClass, TerrainClass, TerrainTypeClass, TriggerClass, UnitClass, UnitTypeClass, Vector3D, WarheadTypeClass, WeaponTypeClass, ThemeClass, ThemeControl, Vector2D } from "YRpp";
{{- if module_name != "Wwise"}}
import { AKRESULT } from "Wwise";
{{- end }}
{{- end }}
{{- for klass in module_classes }}
{{- if need_codegen(klass) }}
{{ klass.is_interface ? "interface" : "class" }} {{klass.identifier}}
{{- if array.size(klass.base_classes) > 0 && klass.base_classes[0].klass && !klass.base_classes[0].klass.is_interface
$base_name = get_ts_type(klass.base_classes[0].cpp_base_type.type)}}
    {{- if $base_name != "any"}}
    extends {{$base_name}}
    {{- end }}
{{- end }}
{
{{- for function in klass.all_functions ; $cpp_function = function.cpp_function }}
        {{- if should_skip_visibility_ex(klass, function) || function.is_deleted || function.is_destructor
            continue
        end
        param_idx = 0
        }}
    {{gen_method(function, $cpp_function)}}
{{- end }}
{{- for property in klass.properties ; $cpp_field = property.cpp_field }}
    {{- if should_skip_visibility_ex(klass, property)
            continue
        end
        if string.empty(property.name)
            continue
        end }}
    {{gen_property(property)}}
{{- end }}
{{- for inner_property in klass.anonymous_inline_properties }}
    {{gen_property(inner_property)}}
{{- end }}
}
{{- end }}
{{- end }}
{{- for enum in module_enums }}
{{- if need_codegen(enum) || is_yrpp }}
enum {{enum.name}} {
    {{- for enum_item in enum.constants }}
    {{enum_item.name}} = {{enum_item.value}},
    {{- end}}
}
{{- end; end }}
}
